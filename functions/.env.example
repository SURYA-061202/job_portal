SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=Indian Infra <your-account@gmail.com>
# Free key from https://www.abstractapi.com/email-validation-validation-api
# Used by the verifyEmailExists function to block signup with non-existent
# mailboxes. Leave empty to skip the check (signup stays open).
ABSTRACT_EMAIL_API_KEY=

# OpenAI key for resume parsing, candidate scoring, applicant ranking and
# clustering (functions/src/ai.ts). Server-side only; never use a VITE_ variable.
OPENAI_API_KEY=
# Optional model overrides (defaults are in functions/src/openaiClient.ts):
# OPENAI_PARSE_MODEL=
# OPENAI_SCORE_MODEL=
# OPENAI_RANK_MODEL=
# OPENAI_LABEL_MODEL=
# OPENAI_EMBED_MODEL=

# Links in emails (interview invites, password resets) must point at this app.
# The default allow-list is the project's web.app / firebaseapp.com sites; add
# your custom domain(s) here, comma separated, and pick the fallback origin.
APP_BASE_URL=
ALLOWED_ORIGINS=

# Razorpay - online payment for recruiter subscription plans (functions/src/payments.ts).
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_... keys until you go live.
# The key id is public (sent to the browser); the secrets never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> Add webhook. URL is the deployed
# razorpayWebhook function; events payment.captured, payment.failed, order.paid.
# Put the secret you typed there here.
RAZORPAY_WEBHOOK_SECRET=
