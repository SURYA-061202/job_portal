rules_version = '2';

// Indian Infra Jobs - Firestore security rules.
// Roles live in users/{uid}.role: 'user' (job seeker), 'recruiter', 'manager', 'admin'.
// Cloud Functions use the Admin SDK and are not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return hasProfile() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    function isAdmin() {
      return myRole() == 'admin';
    }
    function isStaff() {
      return myRole() in ['recruiter', 'manager', 'admin'];
    }
    function isStaffRole(r) {
      return r in ['recruiter', 'manager', 'admin'];
    }
    function myEmail() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // A recruiter may only file a company-verification request ('pending'), and
    // never touch one an admin has already verified. The request's company email
    // must be the one they proved with the emailed code: `companyEmailVerified`
    // is written only by the verifyCompanyEmailCode Cloud Function. Approving or
    // declining is an admin write, which skips this check.
    function companyVerificationOk() {
      return !changedKeys().hasAny(['companyVerification'])
             || (request.resource.data.companyVerification.status == 'pending'
                 && request.resource.data.get('companyEmailVerified', '') == request.resource.data.companyVerification.companyEmail
                 && resource.data.get('companyVerification', {}).get('status', 'none') != 'verified');
    }

    // ---------- users ----------
    match /users/{uid} {
      // Your own profile, anything for staff, and recruiter/admin profiles for
      // any signed-in user (job cards, company pages). Job seekers' profiles are
      // never readable by other job seekers or by signed-out visitors.
      allow get: if signedIn() && (request.auth.uid == uid
                                   || isStaff()
                                   || isStaffRole(resource.data.role));

      // Staff browse every user (candidates list). Anyone signed in can query
      // recruiter/admin profiles (job cards, "notify the admins").
      allow list: if isStaff()
                  || (signedIn() && isStaffRole(resource.data.role))
                  || (signedIn() && resource.data.uid == request.auth.uid);

      // Self sign-up can only ever create a plain 'user'. Admins create recruiters.
      allow create: if signedIn() && (
                      (request.auth.uid == uid && request.resource.data.role == 'user')
                      || isAdmin()
                    );

      // Nobody but an admin can change role, plan or premium flag.
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && !changedKeys().hasAny(['role', 'subscription', 'isPremium', 'uid', 'companyVerified', 'companyEmailVerified'])
                        && companyVerificationOk());

      allow delete: if isAdmin();

      match /testResults/{testId} {
        allow read: if signedIn() && (request.auth.uid == uid || isStaff());
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- subscriptions ----------
    match /subscription_plans/{planId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow read: if signedIn() && (resource.data.recruiterId == request.auth.uid || isAdmin());
      allow create: if signedIn()
                    && request.resource.data.recruiterId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---------- job posts ----------
    match /recruits/{postId} {
      // Signed-in users only. The signed-out candidate pages go through Cloud
      // Functions (see functions/src/candidatePortal.ts) instead of reading posts.
      allow get, list: if signedIn();
      allow create: if isStaff() && request.resource.data.recruiterId == request.auth.uid;
      // Owner or admin edits/deletes; any signed-in user may only record that they viewed it.
      allow update: if (isStaff() && (isAdmin() || resource.data.recruiterId == request.auth.uid))
                    || (signedIn() && changedKeys().hasOnly(['viewedBy']));
      allow delete: if isStaff() && (isAdmin() || resource.data.recruiterId == request.auth.uid);
    }

    // ---------- applications ----------
    match /job_applications/{appId} {
      allow get: if signedIn() && (resource == null || isStaff() || resource.data.user_id == request.auth.uid);
      allow list: if signedIn() && (isStaff() || resource.data.user_id == request.auth.uid);
      allow create: if signedIn() && (
                      isStaff()
                      || (request.resource.data.user_id == request.auth.uid)
                    );
      allow update: if signedIn() && (
                      isStaff()
                      || (resource.data.user_id == request.auth.uid
                          && request.resource.data.user_id == resource.data.user_id
                          && request.resource.data.post_id == resource.data.post_id)
                    );
      allow delete: if signedIn() && (isStaff() || resource.data.user_id == request.auth.uid);
    }

    // ---------- candidates (recruiter side) ----------
    match /candidates/{candidateId} {
      allow get, list, write: if isStaff();
    }

    // ---------- interviews ----------
    match /interviews/{candidateId} {
      // Staff only. Candidates answer invites from an emailed link without
      // signing in; that page talks to the getInterviewInvite /
      // submitInterviewResponse / submitVerifyDetails Cloud Functions, which
      // expose only the offered dates and validate every write.
      allow get, list, write: if isStaff();
    }

    // ---------- notifications (addressed by email in userId) ----------
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == myEmail();
      // Signed-in users create notifications for others (invites, approvals...).
      // Candidate replies from the signed-out pages are written by Cloud Functions.
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == myEmail()
                    && changedKeys().hasOnly(['read', 'viewed']);
      allow delete: if signedIn() && resource.data.userId == myEmail();
    }

    // ---------- saved searches (job alerts) ----------
    // Private to the job seeker who made them.
    match /saved_searches/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- profile views ("who viewed me") ----------
    // One document per recruiter + candidate pair, id = candidateId_recruiterId.
    // Recruiters write their own activity; the candidate reads what is about them.
    match /profile_views/{id} {
      allow read: if signedIn() && (resource.data.candidateId == request.auth.uid
                                    || resource.data.viewerId == request.auth.uid
                                    || isAdmin());
      allow create: if isStaff()
                    && request.resource.data.viewerId == request.auth.uid
                    && id == request.resource.data.candidateId + '_' + request.auth.uid;
      allow update: if isStaff()
                    && resource.data.viewerId == request.auth.uid
                    && request.resource.data.viewerId == resource.data.viewerId
                    && request.resource.data.candidateId == resource.data.candidateId;
      allow delete: if isAdmin();
    }

    // ---------- company reviews (hiring process ratings) ----------
    // One review per person per company (id = companySlug_userId), and only from
    // someone who applied to a job: the application document must exist.
    match /company_reviews/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && id == request.resource.data.companySlug + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/job_applications/$(request.resource.data.postId + '_' + request.auth.uid))
                    && request.resource.data.overall is number
                    && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
                    && request.resource.data.comment.size() <= 1500;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------- messaging (users <-> admin) ----------
    // Everyone except the admin has one thread with the admin, keyed by their own
    // user id, and may write to it at any time. The admin can read and answer all.
    match /support_threads/{threadId} {
      allow get: if signedIn() && (threadId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && !isAdmin()
                    && threadId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (threadId == request.auth.uid || isAdmin())
                    && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderRole', 'readAt', 'adminReadAt']);

      match /messages/{mid} {
        allow read: if signedIn() && (threadId == request.auth.uid || isAdmin());
        allow create: if signedIn() && (threadId == request.auth.uid || isAdmin())
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.senderRole == (isAdmin() ? 'admin' : 'user')
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
      }
    }

    // ---------- messaging (job seeker <-> the recruiter of a post) ----------
    // One thread per seeker per post, id = `${postId}_${seekerUid}`. The seeker
    // opens it with their first message; the post's recruiter reads and answers.
    // The admin may read (moderation) but does not take part.
    match /post_threads/{threadId} {
      function postSeeker() {
        return threadId.matches('.*_' + request.auth.uid);
      }
      function postRecruiter() {
        return get(/databases/$(database)/documents/post_threads/$(threadId)).data.recruiterId == request.auth.uid;
      }

      allow get: if signedIn() && (postSeeker() || resource.data.recruiterId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid
                                    || resource.data.recruiterId == request.auth.uid
                                    || isAdmin());
      // The recruiter on the thread must be the one who really published the post.
      allow create: if signedIn() && postSeeker()
                    && request.resource.data.userId == request.auth.uid
                    && threadId == request.resource.data.postId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/recruits/$(request.resource.data.postId))
                    && get(/databases/$(database)/documents/recruits/$(request.resource.data.postId)).data.recruiterId == request.resource.data.recruiterId;
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.recruiterId == request.auth.uid)
                    && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderRole', 'userReadAt', 'recruiterReadAt']);

      match /messages/{mid} {
        allow read: if signedIn() && (postSeeker() || postRecruiter() || isAdmin());
        allow create: if signedIn() && (postSeeker() || postRecruiter())
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.senderRole == (postSeeker() ? 'user' : 'recruiter')
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
      }
    }

    // ---------- reviews of the portal itself ----------
    // One review per account (id = user id): five stars and a few words. The
    // admin reads them all; a person can read, change or delete only their own.
    match /platform_reviews/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && !isAdmin()
                    && uid == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000;
      allow delete: if signedIn() && (uid == request.auth.uid || isAdmin());
    }

    // ---------- training / clustering ----------
    match /assessments/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /candidate_clusters/{id} {
      allow read, write: if isStaff();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
